{
  "name": "shahathir.me",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.1",
  "scripts": {
    "dev": "concurrently -n next,convex -c blue,green --kill-others-on-fail \"bun run dev:next\" \"bun run dev:convex\"",
    "dev:next": "next dev",
    "dev:convex": "convex dev",
    "prebuild": "bun run sync:pdfjs && bun run sync:typst",
    "build": "next build",
    "start": "next start",
    "start:standalone": "rm -rf .next/standalone/.next/static .next/standalone/public && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && bun .next/standalone/server.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "doctor": "react-doctor",
    "test:e2e": "playwright test",
    "strip-comments": "bun run scripts/strip-comments.ts",
    "strip-comments:write": "bun run scripts/strip-comments.ts --write",
    "prepare": "husky",
    "sync:pdfjs": "rm -rf public/pdfjs && mkdir -p public/pdfjs/build && cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdfjs/build/ && cp -r node_modules/pdfjs-dist/cmaps public/pdfjs/ && cp -r node_modules/pdfjs-dist/standard_fonts public/pdfjs/",
    "sync:typst": "mkdir -p public/typst && cp node_modules/@myriaddreamin/typst-ts-web-compiler/pkg/typst_ts_web_compiler_bg.wasm public/typst/ && cp node_modules/@myriaddreamin/typst-ts-renderer/pkg/typst_ts_renderer_bg.wasm public/typst/"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.75",
    "@base-ui/react": "^1.8.0",
    "@codemirror/language-data": "^6.5.2",
    "@convex-dev/agent": "0.7.1",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@rive-app/react-webgl2": "^4.34.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@uiw/codemirror-extensions-langs": "^4.25.11",
    "@uiw/codemirror-themes-all": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.6",
    "ai": "^7.0.93",
    "autoprefixer": "^10.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.123",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "embla-carousel-react": "^8.6.0",
    "gray-matter": "^4.0.3",
    "input-otp": "^1.5.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^1.41.0",
    "mammoth": "^1.12.2",
    "media-chrome": "^4.19.2",
    "motion": "^13.2.0",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "next-mdx-remote-client": "^2.1.12",
    "next-themes": "^0.4.6",
    "numpy-ts": "^1.7.0",
    "opentype.js": "^2.0.0",
    "react": "^19.2.8",
    "react-codemirror-merge": "^4.25.11",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.5.0",
    "react-resizable-panels": "^4.12.3",
    "recharts": "3.10.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rough-notation": "^0.5.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@next/playwright": "^16.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@types/bun": "^1.4.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.4.1",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "oxc-parser": "^0.148.0",
    "postcss": "^8.5.28",
    "react-doctor": "^0.9.13",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  }
}
