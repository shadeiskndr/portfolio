{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "overrides": [
      {
        // Convex functions are runtime entry points invoked via the generated
        // `api` object, never imported statically, and these lib modules are
        // reached only through them (tools.ts, agent.ts, chat.ts,
        // resumeImport.ts) or through the ingest scripts. The dead-code
        // analyzer (deslop) can't see those call edges and reports every one of
        // them as unused. They are all live.
        "files": ["convex/**", "lib/chat/**", "lib/resume/parse-tex.ts"],
        "rules": ["deslop/unused-file", "deslop/unused-export"]
      },
      {
        // Vendored component registry (shadcn / kibo-ui / smoothui / etc.),
        // kept as a library on purpose: an unreferenced leaf here isn't dead
        // code, it's a component we haven't reached for yet. `use-mobile` is
        // the companion hook the vendored shadcn `sidebar` block imports, so it
        // inherits the same blind spot. Everything else in components/ui/** is
        // held to the same lint gates as first-party code — intentional
        // violations are inline `react-doctor-disable-next-line` comments in
        // the file, not entries here.
        "files": ["components/ui/**", "hooks/use-mobile.ts"],
        "rules": ["deslop/unused-file", "deslop/unused-export"]
      }
    ]
  }
}
